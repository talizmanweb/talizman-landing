---
import { Picture } from 'astro:assets';
import room from '../assets/photos/csaladias-terem.jpg';
import SevenMark from './SevenMark.astro';
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const t = content[Astro.props.lang].about;
---

<section id="rolunk" class="section relative overflow-hidden" aria-labelledby="rolunk-title">
  <div class="wrap grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="relative lg:col-span-6">
      <SevenMark class="pointer-events-none absolute -top-16 -left-10 size-[14rem] text-[var(--accent-text)] opacity-[0.1] sm:size-[19rem]" />
      <h2 id="rolunk-title" class="relative text-[clamp(2.1rem,4.4vw,3.6rem)] leading-[1.06]">
        <span class="sr-only">{t.title}: </span>
        {t.quote}
      </h2>
      <div class="relative mt-8 grid max-w-[60ch] gap-4 text-[var(--text-soft)]">
        {t.body.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>
    <div class="lg:col-span-6">
      <Picture
        src={room}
        alt={t.imgAlt}
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 1024px) 38rem, 100vw"
        formats={['avif', 'webp']}
        class="aspect-[4/3] w-full rounded-[1.25rem] object-cover"
      />
    </div>
  </div>
</section>
