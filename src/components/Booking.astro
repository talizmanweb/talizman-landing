---
import { Picture } from 'astro:assets';
import lamp from '../assets/photos/lampas-asztal.jpg';
import SevenMark from './SevenMark.astro';
import { business, content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].booking;

// Booking is e-mail only: a plain mailto link with a subject and a short template to fill in.
const mailto = `mailto:${business.email}?subject=${encodeURIComponent(t.subject)}&body=${encodeURIComponent(t.bodyTemplate.join('\n'))}`;
---

<section id="foglalas" class="section night" aria-labelledby="foglalas-title">
  <div class="wrap grid items-stretch gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="hidden lg:col-span-5 lg:block">
      <Picture
        src={lamp}
        alt={t.imgAlt}
        widths={[480, 800, 1100]}
        sizes="30rem"
        formats={['avif', 'webp']}
        class="h-full max-h-[40rem] w-full rounded-[1.25rem] object-cover"
      />
    </div>

    <div class="flex flex-col justify-center lg:col-span-7">
      <h2 id="foglalas-title" class="h-section">
        {t.title}
      </h2>
      <p class="mt-6 max-w-[48ch] text-[1.15rem] text-[var(--text-soft)]">{t.lead}</p>

      <p class="mt-10 text-[0.95rem] font-semibold">{t.checklistTitle}</p>
      <ul class="mt-3 border-t border-[var(--line)]">
        {t.checklist.map((item) => (
          <li class="flex items-center gap-4 border-b border-[var(--line)] py-4 font-display text-[1.35rem] leading-snug">
            <SevenMark class="size-6 shrink-0 text-[var(--brass)]" />
            {item}
          </li>
        ))}
      </ul>

      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
        <a href={mailto} class="btn btn-brass min-h-14 px-7 text-[1.05rem]">
          <svg
            viewBox="0 0 24 24"
            class="size-5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="m4 7 8 6 8-6"></path>
          </svg>
          {t.submit}
        </a>
        <a
          href={`mailto:${business.email}`}
          class="font-display text-[1.5rem] break-all text-[var(--on-night)]"
        >
          {business.email}
        </a>
      </div>
    </div>
  </div>
</section>
