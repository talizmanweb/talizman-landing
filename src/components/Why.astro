---
import { Picture } from 'astro:assets';
import plate from '../assets/photos/talalas.jpg';
import SevenMark from './SevenMark.astro';
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const t = content[Astro.props.lang].why;
---

<section id="alkalmak" class="section" aria-labelledby="miert-title">
  <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7">
      <h2 id="miert-title" class="h-section">
        {t.title}
      </h2>
      <ul class="mt-12 grid gap-8">
        {t.items.map((item) => (
          <li class="flex items-baseline gap-5">
            <SevenMark class="size-7 shrink-0 translate-y-1 text-[var(--accent-text)]" />
            <span class="font-display text-[clamp(1.5rem,2.6vw,2.15rem)] leading-[1.15]">{item}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="lg:col-span-5">
      <Picture
        src={plate}
        alt={t.imgAlt}
        widths={[480, 800, 1100]}
        sizes="(min-width: 1024px) 30rem, 100vw"
        formats={['avif', 'webp']}
        class="aspect-[4/5] w-full rounded-[1.25rem] object-cover lg:aspect-[3/4]"
      />
    </div>
  </div>

  <div class="wrap mt-20 border-t border-[var(--line)] pt-10 lg:mt-28">
    <p class="text-[var(--text-soft)]">{t.occasionsLead}</p>
    <ul class="mt-4 flex flex-wrap items-baseline gap-x-[0.45em] font-display text-[clamp(2.1rem,6vw,4.75rem)] leading-[1.08] tracking-[-0.02em]">
      {t.occasions.map((o, i) => (
        <li class="whitespace-nowrap">
          {o}
          {i < t.occasions.length - 1 && (
            <span class="ml-[0.3em] text-[var(--accent-text)]" aria-hidden="true">
              ·
            </span>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
